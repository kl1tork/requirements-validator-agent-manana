# Пример конфигурации. Скопируйте в .env и укажите ключ:  cp .env.example .env
# ВНИМАНИЕ: файл .env с реальным ключом НЕ коммитится (он в .gitignore).

# Провайдер: gemini | openai | anthropic | ollama
# Если не задан — берётся первый провайдер, для которого указан ключ.
LLM_PROVIDER=gemini

# Google Gemini API (бесплатный ключ: https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
# Запасные модели (через запятую), если основная перегружена (503) или снята (404). Пусто — не переключаться.
# GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.8-flash

# OpenAI или любой OpenAI-совместимый endpoint (OpenRouter, Groq, vLLM, LM Studio)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Локальная модель (Ollama)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:14b

# Тонкая настройка (необязательно)
# LLM_TEMPERATURE=0           # 0 — максимально воспроизводимый прогон
# LLM_MIN_INTERVAL=6.5        # пауза между запросами, с (бесплатный тариф Gemini ≈ 10 запросов/мин)
# LLM_MAX_OUTPUT_TOKENS=32768
# LLM_TIMEOUT=300
# LLM_CACHE=1                 # 1 — кэшировать ответы модели в .cache/, 0 — выключить
